# Copy to `.env` and fill in. NEVER commit the real .env file.

# Talk mode in the hum feature (hum/engine/talk). Without them the song still gets made; only the
# chat/voice edits say "GEMINI_API_KEY is missing".
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional: where hummed recordings and songs are kept (default backend/hum_data, never served by URL)
# HUM_DATA_DIR=
# Optional: a General MIDI soundfont for rendering songs. Default: the copy in
# hum/engine/accompanist/soundfonts/ (see hum/README.md)
# SOUNDFONT_PATH=
